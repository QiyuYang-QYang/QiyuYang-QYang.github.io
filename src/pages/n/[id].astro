---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NodeArticle from '../../components/NodeArticle.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('nodes')).filter((e) => !e.data.hidden);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---
<Base mode="node" id={entry.id} title={entry.data.title} description={entry.data.summary}>
  <NodeArticle entry={entry} />
</Base>
