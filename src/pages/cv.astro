---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const entry = (await getEntry('pages', 'cv'))!;
const { Content } = await render(entry);
---
<Base mode="shelf" id="cv" title={entry.data.title} description={entry.data.summary}>
  <section class="shelf-page" data-shelf="cv">
    <header class="shelf-head">
      <p class="shelf-count">Qiyu Yang</p>
      <h1 class="shelf-title">{entry.data.title}</h1>
    </header>
    <div class="prose shelf-prose"><Content /></div>
    {entry.data.placeholder && <p class="placeholder">Placeholder text, to be rewritten.</p>}
  </section>
</Base>
