---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageArticle from '../components/PageArticle.astro';
const entry = (await getEntry('pages', 'about'))!;
const { Content } = await render(entry);
---
<Base mode="page" id="about" title={entry.data.title} description={entry.data.summary}>
  <PageArticle title={entry.data.title} summary={entry.data.summary} placeholder={entry.data.placeholder}>
    <Content />
  </PageArticle>
</Base>
