---
import { site } from '../site.config';
const path = Astro.url.pathname;
const nav = [
  ...site.categories.map((c) => ({ href: `/${c.id}/`, title: c.title })),
  ...site.pages.map((p) => ({ href: `/${p.id}/`, title: p.title })),
];
---
<header class="site-head glass" transition:name="header">
  <a class="site-name" href="/">{site.name}</a>
  <nav class="site-nav" aria-label="Sections">
    {nav.map((n) => (
      <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.title}</a>
    ))}
  </nav>
</header>
