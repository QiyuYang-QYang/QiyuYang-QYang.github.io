---
import { render } from 'astro:content';
import { getAtlas, TYPE_LABEL, type NodeEntry } from '../lib/atlas';

const { entry } = Astro.props as { entry: NodeEntry };
const atlas = await getAtlas();
const { Content } = await render(entry);
const links = atlas.neighbors[entry.id] ?? [];
const hasBody = Boolean(entry.body?.trim());
---
<article class="article" data-type={entry.data.type}>
  <p class="kicker">{TYPE_LABEL[entry.data.type]}</p>
  <h1 class="article-title">{entry.data.title}</h1>
  <p class="lead">{entry.data.summary}</p>
  {entry.data.cover && <img class="article-cover" src={entry.data.cover} alt={entry.data.title} />}
  {hasBody && <div class="prose"><Content /></div>}
  {entry.data.placeholder && <p class="placeholder">Placeholder text, to be rewritten.</p>}
  {links.length > 0 && (
    <section class="connections" aria-label="Connected nodes">
      <h2>Connected through</h2>
      {links.map((l) => {
        const n = atlas.byId[l.id];
        return (
          <a href={n.href}>
            <span class="q">{l.q}</span>
            <span class="t" data-ghost>{n.title}</span><span class="k">{TYPE_LABEL[n.type]}</span>
          </a>
        );
      })}
    </section>
  )}
</article>
