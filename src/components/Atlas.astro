---
import type { Atlas } from '../lib/atlas';
const { atlas } = Astro.props as { atlas: Atlas };
const data = JSON.stringify({ nodes: atlas.nodes, edges: atlas.edges });
---
<div class="atlas" id="atlas">
  <div class="atlas-scroll" id="atlas-scroll">
    <div class="atlas-inner">
      <div class="hero" id="hero">
        <p>Studying systems, connecting signals, make them in ONE unity: life, machines, society.</p>
        <p class="sub">Computational Biology, Carnegie Mellon University 2025.8 - Now · <a href="/about/">About</a></p>
      </div>
      <svg id="atlas-svg" role="group" aria-label="Map of questions, work, and writing"></svg>
      <div class="legend" id="legend" aria-hidden="true">
        <span><svg viewBox="-7 -7 14 14"><circle class="s-ring" r="6"></circle><circle class="s-core" r="1.6"></circle></svg>Question</span>
        <span><svg viewBox="-7 -7 14 14"><circle class="s-solid" r="4.5"></circle></svg>Work</span>
        <span><svg viewBox="-7 -7 14 14"><rect class="s-solid" x="-4" y="-4" width="8" height="8" transform="rotate(45)"></rect></svg>Writing</span>
        <span><svg viewBox="-7 -7 14 14"><rect class="s-photo" x="-4.5" y="-3.5" width="9" height="7"></rect></svg>Photograph</span>
        <span><svg viewBox="-7 -7 14 14"><circle class="s-past" r="4.5"></circle></svg>Earlier</span>
        <span class="hint" id="atlas-hint"></span>
      </div>
    </div>
  </div>
</div>

<div class="sheet" id="sheet" aria-live="polite">
  <p class="t"></p>
  <a class="sheet-link" href="/"><span class="title" data-ghost></span></a>
  <p class="s"></p>
  <a class="open sheet-link" href="/">Open</a>
</div>

<script type="application/json" id="atlas-data" set:html={data}></script>
