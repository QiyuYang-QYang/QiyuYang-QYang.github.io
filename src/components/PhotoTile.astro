---
import type { Item } from '../lib/content';
const { item, i } = Astro.props as { item: Item; i: number };
const d = item.entry.data;
---
<li style={`--i:${i}`}>
  <a class="photo" href={item.href}>
    {d.cover ? <img src={d.cover} alt={d.title} loading="lazy" decoding="async" /> : <span class="photo-missing glass">No image set</span>}
    <span class="tag-row"><span>N° {item.number}</span><span>{d.title}</span>{d.year && <span>{d.year}</span>}</span>
  </a>
</li>
